# On most hosts (Render/Railway) PORT is injected automatically; the app falls
# back to 5050 locally. NODE_ENV=production in prod also stops raw DB error text
# from being echoed in API responses.
PORT=5050
NODE_ENV=development

# REQUIRED — the Postgres connection string. This is the ONLY database variable
# the app reads (server/config/db.js); the pool connects over SSL. For Supabase:
# Dashboard -> Project Settings -> Database -> Connection string -> Transaction
# pooler (port 6543). Without it the server starts but every query fails.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# REQUIRED — signs/verifies auth tokens. Use a long random string. If unset,
# login/register throw (jsonwebtoken needs a secret), so set it before deploying.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# This email is automatically given the admin role on registration, and
# scripts/migrate-admin-features.js promotes it if it already exists.
ADMIN_EMAIL=gkolbaia2008@gmail.com

# REQUIRED IN PRODUCTION — the exact origin of the deployed frontend. Any
# localhost:* origin is allowed automatically in dev, but in production the live
# frontend URL must match this or CORS rejects every browser request.
CLIENT_URL=http://localhost:5173

# --- Password-reset email (Nodemailer / Gmail SMTP) ---
# The password-reset flow sends the 6-digit code via Gmail SMTP (Nodemailer).
# EMAIL_USER is the Gmail address; EMAIL_PASS is a 16-char Gmail APP PASSWORD
# (NOT your normal password) — create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Enter it without spaces. If unset, no email is
# sent (the code is still never exposed to the client).
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password
