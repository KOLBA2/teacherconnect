{
  "name": "teacher-connection",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "predev:all": "node scripts/free-dev-ports.mjs",
    "dev:all": "concurrently -n FRONTEND,BACKEND -c blue,green --kill-others-on-fail \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "lint": "echo 'No linting configured'",
    "preview": "vite preview",
    "postinstall": "npm install --prefix server"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "lucide-react": "^0.395.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11"
  }
}
